# BikeVault — Strava API Configuration
# Obtain credentials from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# BikeVault — Production Server-Side Token Storage (Vercel KV or Upstash Redis)
# Automatically configured when creating Vercel KV in project dashboard (Storage -> KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Or Upstash Redis REST credentials (alternative to Vercel KV)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

