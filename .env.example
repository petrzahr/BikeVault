# BikeVault — Strava API Configuration
# Obtain credentials from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# BikeVault — Production Server-Side Token Storage (Vercel KV or Upstash Redis)
# Automatically configured when creating Vercel KV in project dashboard (Storage -> KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Or Upstash Redis REST credentials (alternative to Vercel KV)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# BikeVault — Local UI development only. NEVER set these on Vercel.
# Demo storage mode: the app cache uses a separate demo localStorage key instead of the production one.
# NEXT_PUBLIC_ENABLE_DEMO_DATA=true
# Dev login bypass (needs demo mode + `next dev` + localhost): skips Google sign-in, never calls Drive.
# NEXT_PUBLIC_DEV_AUTH_BYPASS=true

